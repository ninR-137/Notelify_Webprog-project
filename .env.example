SPRING_APPLICATION_NAME=demo

# Gmail SMTP configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_CONNECTION_TIMEOUT=5000
SPRING_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_SMTP_WRITE_TIMEOUT=5000

# App mail/OTP configuration
APP_MAIL_FROM=your-email@gmail.com
APP_MAIL_API_KEY=
APP_MAIL_API_URL=https://api.resend.com/emails
APP_OTP_TTL_MINUTES=5

# JWT configuration
APP_JWT_SECRET=replace-with-a-long-random-base64-secret
APP_JWT_ACCESS_TOKEN_MINUTES=15
APP_JWT_REFRESH_TOKEN_DAYS=7
